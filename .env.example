# ── Scout Environment Template ──────────────────────────────────────────────
# Scout is the Aurie UGC content pipeline agent, built on claude-code-slack.
# Copy to .env and fill in real values. Never commit .env to git.

# ── Required: Slack ──────────────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-...)
# Get from: https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for Socket Mode (xapp-...)
# Get from: https://api.slack.com/apps → Basic Information → App-Level Tokens
# Required scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Slack Signing Secret (optional, for HTTP mode)
SLACK_SIGNING_SECRET=

# ── Required: Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Required: Directory ─────────────────────────────────────────────────────
# The directory Claude Code is allowed to read/write within
APPROVED_DIRECTORY=/app

# ── Auth: Allowed Users ─────────────────────────────────────────────────────
# Comma-separated Slack user IDs (e.g. U01ABC123,U02DEF456)
# Leave empty to allow all users in your workspace (not recommended in production)
ALLOWED_USERS=

# Secret for generating auth tokens (generate: openssl rand -hex 32)
AUTH_TOKEN_SECRET=

# ── Bot Identity ─────────────────────────────────────────────────────────────
BOT_NAME=Scout
ENVIRONMENT=production

# ── Claude Settings ───────────────────────────────────────────────────────────
USE_SDK=true
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_CLI_PATH=
CLAUDE_MAX_TURNS=10
CLAUDE_TIMEOUT_SECONDS=300
CLAUDE_MAX_COST_PER_USER=10.0

# Allowed Claude tools
CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,LS,Task,TaskOutput,MultiEdit,NotebookRead,NotebookEdit,WebFetch,TodoRead,TodoWrite,WebSearch,AskUserQuestion,Skill,ScheduleJob,ListScheduledJobs,RemoveScheduledJob,SlackFileUpload,SlackReaction

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/bot.db
DATABASE_PATH=data/bot.db
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=5

# ── Features ─────────────────────────────────────────────────────────────────
AGENTIC_MODE=true
ENABLE_API_SERVER=true
API_SERVER_PORT=8080
ENABLE_SCHEDULER=true
ENABLE_PROJECT_CHANNELS=false
ENABLE_MCP=false
MCP_CONFIG_PATH=config/mcp.json
ENABLE_GIT_INTEGRATION=true
ENABLE_FILE_UPLOADS=true
ENABLE_QUICK_ACTIONS=true
ENABLE_SESSION_EXPORT=true
ENABLE_IMAGE_UPLOADS=true
ENABLE_CONVERSATION_MODE=true

# ── Project Channels (optional) ──────────────────────────────────────────────
PROJECTS_CONFIG_PATH=config/projects.yaml

# ── Verbosity ─────────────────────────────────────────────────────────────────
# 0 = quiet (final response only)
# 1 = normal (tool names + reasoning)
# 2 = detailed (tool inputs + longer reasoning)
VERBOSE_LEVEL=1

# ── Security ─────────────────────────────────────────────────────────────────
# Set to true only in fully trusted environments
DISABLE_SECURITY_PATTERNS=false
DISABLE_TOOL_VALIDATION=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=20

# ── Webhooks (optional) ───────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
WEBHOOK_API_SECRET=

# ── Notifications (optional) ─────────────────────────────────────────────────
# Comma-separated Slack channel IDs for proactive notifications
NOTIFICATION_CHANNEL_IDS=

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_TIMEZONE=America/Los_Angeles

# ── Billing / Spend Limits ────────────────────────────────────────────────────
# Monthly spend limit in USD (used by scripts/billing_check.py)
BILLING_LIMIT_USD=50

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_FILE_UPLOAD_SIZE_MB=100
MAX_ARCHIVE_PREVIEW_FILES=5
QUICK_ACTIONS_TIMEOUT=120
GIT_OPERATIONS_TIMEOUT=30

# ── Monitoring ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_TELEMETRY=false
SENTRY_DSN=

# ── Development ───────────────────────────────────────────────────────────────
DEBUG=false
DEVELOPMENT_MODE=false
